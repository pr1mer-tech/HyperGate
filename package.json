{
  "name": "hypergate",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "publish-packages": "bun run build && changeset version && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.3",
    "@typescript/vfs": "1.3.0",
    "autoprefixer": "^10.4.20",
    "bunup": "^0.16.31",
    "changeset": "^0.2.6",
    "postcss": "^8.4.41",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.10",
    "tsup": "^8.4.0",
    "turbo": "^2.1.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "bunchee": "^6.5.1"
  }
}
